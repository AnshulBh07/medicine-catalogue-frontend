# ==============================================================================
# Medicina Catalogue Mobile - Environment Variables Template
#
# INSTRUCTIONS:
# - For local development: copy to .env.development
#     Local emulator / web: EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
#     Physical device: EXPO_PUBLIC_API_BASE_URL=http://<YOUR_LOCAL_IP>:3000/api/v1
# - For production build: copy to .env.production
#     Production VPS: EXPO_PUBLIC_API_BASE_URL=http://<VPS_IP_OR_DOMAIN>/api/v1
#
# NEVER commit .env, .env.development, or .env.production to version control.
# ==============================================================================

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
